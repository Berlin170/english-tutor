# Copy this file to .env.local and paste your keys below.

# Your Claude API key from https://console.anthropic.com -> API Keys
# Powers the live call, chat and grammar check.
ANTHROPIC_API_KEY=

# Gonka AI, from https://gonka-api.org/dashboard
# Powers the Story Reader only. Copy BASE URL and the sk_... key from the
# dashboard. Without these, /story shows an error; everything else still works.
GONKA_BASE_URL=
GONKA_API_KEY=
